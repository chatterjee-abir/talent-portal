<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      PARENT: spring-boot-starter-parent manages ALL dependency versions for us.
      We never need to specify versions for Spring libraries — the parent handles it.
      Think of it as inheriting a tested, compatible set of library versions.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <!-- PROJECT COORDINATES: uniquely identifies this project in the Maven world -->
    <groupId>com.talentportal</groupId>
    <artifactId>talent-portal-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>talent-portal-backend</name>
    <description>P&amp;C Insurance Talent Portal — Spring Boot Backend</description>

    <properties>
        <!-- Use Java 21 (what's installed). Spring Boot 3.2 supports Java 17+ -->
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
          WEB: Adds an embedded Tomcat server + Spring MVC for REST endpoints.
          Without this, the app has no HTTP server and no @RestController support.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          DATA JPA: Adds Hibernate (ORM) + Spring Data repositories.
          This is what lets you write AssociateRepository extends JpaRepository
          and get save(), findAll(), findById() etc. for free.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          VALIDATION: Adds @NotNull, @Size, @NotBlank annotations for input validation.
          Used on DTO classes to reject bad API requests before they hit the database.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          MYSQL DRIVER: The JDBC connector that lets Java talk to MySQL.
          Spring Boot auto-detects it and configures the DataSource automatically
          as long as spring.datasource.* properties are set.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          LOMBOK: A code generation library. Annotations like @Data, @Getter,
          @Setter, @NoArgsConstructor eliminate hundreds of lines of boilerplate.
          It runs at compile time — the generated code never appears in source files.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- TEST: JUnit 5 + Mockito + Spring Test. Included by default. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              SPRING BOOT MAVEN PLUGIN: Packages the app as an executable JAR.
              'mvn spring-boot:run' uses this to start the app directly.
              'mvn clean package' creates a fat JAR with all dependencies bundled.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the final JAR (only needed at compile time) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
